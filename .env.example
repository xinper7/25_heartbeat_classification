# Copy to .env. URL-encode special characters in the password (see README).
DATABASE_URL=mysql+pymysql://ecg_app:CHANGE_ME@127.0.0.1:3306/ecg_platform?charset=utf8mb4
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_THREADS=2
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=180
INFERENCE_CONCURRENCY=1
